FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
COPY src /app/src
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir '.[vision,server]'

ENV PYTHONPATH=/app/src
ENV EYERIS_MODEL_VERSION=external-weights
EXPOSE 8080

CMD ["uvicorn", "eyeris.model_server:app", "--host", "0.0.0.0", "--port", "8080"]
